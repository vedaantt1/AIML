from queue import PriorityQueue

def bfs(graph, start, target, heuristics):
    visited = set()
    pq = PriorityQueue()
    
    
    pq.put((heuristics[start], start, [start]))

    while not pq.empty():
        h, node, path = pq.get()

        if node == target:
            return path, h  

        if node in visited:
            continue
        visited.add(node)

        
        for neighbor in graph.get(node, []):
            if neighbor not in visited:
                pq.put((heuristics[neighbor], neighbor, path + [neighbor]))

    return None, None

if __name__ == "__main__":
    graph = {
        'A': ['B', 'C'],
        'B': ['D', 'E'],
        'C': ['F'],
        'D': [],
        'E': ['F'],
        'F': []
    }

    heuristics = {
        'A': 7,
        'B': 6,
        'C': 2,
        'D': 1,
        'E': 0,
        'F': 0
    }

    start_node = 'A'
    target_node = 'F'
    path, heuristic_value = bfs(graph, start_node, target_node, heuristics)

    if path:
        print(f"Path found: {' -> '.join(path)} with heuristic value: {heuristic_value}")
    else:
        print("No path found.")








        
