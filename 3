class MeansEndAnalysis:
    def __init__(self, operators):
        self.operators = operators

    def find_difference(self, current, goal):
        for key in goal:
            if current.get(key) != goal[key]:
                return (key, goal[key])
        return None

    def select_operator(self, diff):
        diff_key, diff_val = diff
        for op in self.operators:
            if op.get('effect', {}).get(diff_key) == diff_val:
                return op
        return None

    def solve(self, current, goal):
        print(f"Current State: {current}, Target Goal: {goal}")
        
       
        if all(current.get(k) == v for k, v in goal.items()):
            return []

        diff = self.find_difference(current, goal)
        if not diff:
            return []

        op = self.select_operator(diff)
        if not op:
            print(f"No operator found to resolve difference: {diff}")
            return None
        
        
        print(f"  └─► Selected Operator: '{op['name']}' to resolve diff {diff}")
        print(f"      Preconditions required: {op['preconditions']}")
        print(f"      Effects applied: {op['effect']}\n")

        
        preconditions_path = self.solve(current, op['preconditions'])
        if preconditions_path is None:
            return None

        
        new_state = current.copy()
        for key, val in op['effect'].items():
            new_state[key] = val

        
        remaining_path = self.solve(new_state, goal)
        if remaining_path is None:
            return None

        return preconditions_path + [op['name']] + remaining_path


if __name__ == "__main__":
    operators = [
        {
            'name': 'Drive_car',
            'preconditions': {'has_car': True, 'at_home': True},
            'effect': {'at_work': True}
        },
        {
            'name': 'Buy_car',
            'preconditions': {'money': True},
            'effect': {'has_car': True}
        },
    ]

    mea = MeansEndAnalysis(operators)

    current_state = {'has_car': False, 'money': True, 'at_home': True, 'at_work': False}
    goal_state = {'at_work': True}

    plan = mea.solve(current_state, goal_state)
    print("Execution plan:", plan)
